{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smashcat-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",

  // Vite のビルド成果物を静的アセットとして配信する。deploy 前に
  // `pnpm build` が必要 (deploy スクリプトが両方走らせる)。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // Custom Domain 方式。deploy 時に Cloudflare が DNS レコードと証明書を
  // 自動で用意するため、手動で DNS を設定する必要がない。
  //
  // パターン方式 (`smashcat.dev/*` + `zone_name`) だと、ルートはホスト名を
  // 解決可能にはしてくれない。買ったばかりのゾーンには apex のレコードが
  // 無いため、別途 proxied なレコードを置かないとリクエストが Cloudflare に
  // 到達せず、ルートも発火しない。Worker がホスト名全体を持つ構成なので
  // Custom Domain の方が素直に収まる。
  //
  // パスを含められないので `/*` は付けない。ホスト名に来たものは全部 Worker
  // に渡る (/medley-generator/ の振り分けは worker/index.ts 側の仕事)。
  "routes": [
    { "pattern": "smashcat.dev", "custom_domain": true },
    { "pattern": "www.smashcat.dev", "custom_domain": true }
  ]
}
