{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smashcat-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",

  // Vite のビルド成果物を静的アセットとして配信する。deploy 前に
  // `pnpm build` が必要 (deploy スクリプトが両方走らせる)。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // smashcat.dev を Cloudflare に委任し、ゾーンを有効にしてから deploy する。
  "routes": [
    { "pattern": "smashcat.dev/*", "zone_name": "smashcat.dev" },
    { "pattern": "www.smashcat.dev/*", "zone_name": "smashcat.dev" }
  ]
}
